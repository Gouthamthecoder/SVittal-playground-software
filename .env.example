# Copy this file to .env and fill in your values.
# In Replit, these are set automatically or via the Secrets panel — do NOT commit .env to GitHub.

# PostgreSQL connection string used by the serverless application. For Vercel,
# use the Supabase transaction-pooler URL (port 6543).
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Used only while applying schema migrations. For Vercel, use Supabase's direct
# connection (port 5432) or the session pooler (also port 5432).
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Session secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret

# Only set these when intentionally creating the first admin in a new database.
# SEED_DEFAULT_DATA=true
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=use-a-strong-password-with-10-or-more-characters
