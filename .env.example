# Copy this file to .env and fill in your values.
# In Replit, these are set automatically or via the Secrets panel — do NOT commit .env to GitHub.

# PostgreSQL connection string (provided automatically by Replit's built-in database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-secret
